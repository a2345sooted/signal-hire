# Mandatory: Your OpenAI API Key
# Get one at https://platform.openai.com/
OPENAI_API_KEY=your_api_key_here

# Database Configuration
DB_NAME=signal
DB_USER=local
DB_PASSWORD=local
DB_HOST=localhost
DB_PORT=5432

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=your-api-identifier
AUTH0_CLIENT_ID=your-auth0-management-client-id
AUTH0_CLIENT_SECRET=your-auth0-management-client-secret

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# SES Configuration
SES_REGION=us-east-1
SES_ACCESS_KEY=your_ses_access_key
SES_SECRET_KEY=your_ses_secret_key
SES_SENDER_EMAIL=noreply@example.com
